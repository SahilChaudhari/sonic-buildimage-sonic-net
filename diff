+function migrate_dpu_config()
+{
+    # This function migrates configuration from old_config directory
+    # to the new SONiC database after a firmware upgrade
+
+    # Check if old config exists
+    if [ ! -d /host/old_config ]; then
+        log_msg "DPU config migration: No old_config directory found, skipping"
+        return 0
+    fi
+
+    log_msg "DPU config migration: Old configuration detected, starting migration..."
+
+    # Wait for database to be fully ready with timeout
+    MAX_WAIT=60
+    count=0
+    while [ $count -lt $MAX_WAIT ]; do
+        if sonic-db-cli PING 2>/dev/null | grep -q PONG; then
+            log_msg "DPU config migration: Database is ready"
+            break
+        fi
+        count=$((count + 1))
+        sleep 1
+    done
+
+    if [ $count -ge $MAX_WAIT ]; then
+        log_msg "ERROR: DPU config migration: Database not ready after ${MAX_WAIT}s, aborting migration"
+        return 1
+    fi
+
+    # Load old config into Redis
+    if [ -f /host/old_config/config_db.json ]; then
+        log_msg "DPU config migration: Loading old configuration into database..."
+        if [ -f /etc/sonic/init_cfg.json ]; then
+            sonic-cfggen -j /etc/sonic/init_cfg.json -j /host/old_config/config_db.json --write-to-db
+        else
+            sonic-cfggen -j /host/old_config/config_db.json --write-to-db
+        fi
+        log_msg "DPU config migration: Old configuration loaded successfully"
+
+        # Run database migration
+        if [ -x /usr/local/bin/db_migrator.py ]; then
+            log_msg "DPU config migration: Running database schema migration..."
+            /usr/local/bin/db_migrator.py -o migrate
+            log_msg "DPU config migration: Database migration completed"
+        fi
+
+        # Mark as initialized
+        sonic-db-cli CONFIG_DB SET "CONFIG_DB_INITIALIZED" "1"
+        log_msg "DPU config migration: Configuration migrated successfully"
+    else
+        log_msg "Warning: DPU config migration: /host/old_config/config_db.json not found"
+    fi
+
+    # Copy other config files
+    if [ -f /host/old_config/snmp.yml ]; then
+        cp /host/old_config/snmp.yml /etc/sonic/
+        log_msg "DPU config migration: Restored snmp.yml"
+    fi
+
+    # Archive old config for reference
+    if [ -d /host/old_config ]; then
+        ARCHIVE_DIR="/host/config_archive_$(date +%Y%m%d_%H%M%S)"
+        mv /host/old_config "$ARCHIVE_DIR"
+        log_msg "DPU config migration: Old config archived to $ARCHIVE_DIR"
+    fi
+
+    log_msg "DPU config migration: Migration completed successfully"
+    return 0
+}
