+# Backup current configuration before upgrade
+backup_config()
+{
+    if [ "$install_env" = "sonic" ]; then
+        echo "==> Backing up current configuration"
+
+        # Ensure latest config is saved to disk (optional but safe)
+        if command -v config >/dev/null 2>&1; then
+            config save -y 2>/dev/null || echo "Warning: config save failed, using existing config_db.json"
+        fi
+
+        # Remove old backup and create new one
+        rm -rf /host/old_config
+        mkdir -p /host/old_config
+
+        # Backup essential config files if they exist
+        [ -f /etc/sonic/config_db.json ] && cp /etc/sonic/config_db.json /host/old_config/ && echo "  Backed up config_db.json"
+        [ -f /etc/sonic/database_config.json ] && cp /etc/sonic/database_config.json /host/old_config/ && echo "  Backed up database_config.json"
+        [ -f /etc/sonic/snmp.yml ] && cp /etc/sonic/snmp.yml /host/old_config/ && echo "  Backed up snmp.yml"
+
+        echo "Configuration backed up to /host/old_config"
+    fi
+}
